{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-issue-tracker",
  "description": "Allow the hosted Batchlogg app to open external links, save downloads, and toggle fullscreen.",
  "remote": {
    "urls": ["https://batchlogg.vercel.app/*"]
  },
  "local": false,
  "windows": ["main"],
  "permissions": [
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "allow-save-download",
    "allow-toggle-fullscreen"
  ]
}
