{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Batchlogg",
  "version": "0.2.3",
  "identifier": "com.batchlogg.desktop",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Batchlogg",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src https://batchlogg.vercel.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
